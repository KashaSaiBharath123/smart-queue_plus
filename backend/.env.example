# ── Server ──────────────────────────────────────────────
PORT=5000

# ── MongoDB ─────────────────────────────────────────────
# Local:
MONGO_URI=mongodb://localhost:27017/smartqueue
# Atlas (cloud):
# MONGO_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/smartqueue

# ── Auth ────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_strong_random_secret

# ── App ─────────────────────────────────────────────────
NODE_ENV=development
